{
	"compilerOptions": {
		"module": "Node16",
		"target": "ES2022",
		"lib": [
			"ES2022"
		],
		"types": ["node"],
		"sourceMap": true,
		"rootDir": "src",
		"outDir": "out",
		"strict": true,
		"skipLibCheck": true,
		"resolveJsonModule": true
	},
	"exclude": [
		"vite.config.ts",
		"vite.monaco.config.ts",
		"vite.imageViewer.config.ts",
		"vite.sidebar.config.ts",
		"vite.titlebar.config.ts",
		"vite.remoteWorkspace.config.ts",
		"src/webview/**/*",
		"src/test/**/*",
		"test/**/*",
		"scripts/**/*",
		"electron",
		"e2e"
	]
}
