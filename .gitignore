node_modules
dist/
dist-electron/
out/
release/

# Rust 构建产物（Standalone Core / TUI）；由 `npm run build:core` / cargo 重建，不入库
core-rs/target/
installer-rs/target/
tui-rs/target/
resources/core/
*.vsix
.watch-app.pid
.watch-ext.pid

# 测试产物：vscode-test 下载的 VS Code、c8 覆盖率报告
.vscode-test/
coverage/

# 本地实验脚本与截图（CDP 探针 / 渲染预览），不属于产品代码
exp/

# Playwright e2e 产物（trace / 失败上下文快照）
test-results/
playwright-report/

# E2E 测试环境配置（真实 SSH 等外部环境信息，含凭证）：从 environments.example.json
# 复制并填写，只留本地不入库
e2e/environments.json

# ZCode 本地会话状态（规划稿等）与本地忽略文件不入库。技能入库在 .agents/skills；
# .zcode/skills 只是本机指向它的 junction，不穿透提交（避免同一份技能两份 blob）
.zcode/*
.zcodeignore

# PyCharm 插件宿主（specs/035）：Gradle 构建产物 / 缓存 / 机器相关覆盖 / 本机工具链与发行包
pycharm-plugin/.gradle/
pycharm-plugin/build/
pycharm-plugin/local.properties
pycharm-plugin/.intellijPlatform/
.gradle-dist/
