node_modules
dist/
dist-electron/
out/
release/

# Rust 构建产物（Standalone Core / TUI）；由 `npm run build:core` / cargo 重建，不入库
core-rs/target/
installer-rs/target/
tui-rs/target/
resources/core/
*.vsix
.watch-app.pid
.watch-ext.pid

# 测试产物：vscode-test 下载的 VS Code、c8 覆盖率报告
.vscode-test/
coverage/

# 本地实验脚本与截图（CDP 探针 / 渲染预览），不属于产品代码
exp/

# Playwright e2e 产物（trace / 失败上下文快照）
test-results/
playwright-report/

# ZCode 本地会话状态（规划稿等）与本地忽略文件不入库；skills 入库（本机是指向
# .tuxedo-cat/skills 的 junction，git 穿透它以 .zcode/skills 路径提交同一份文件）
.zcode/*
.zcodeignore
!.zcode/skills/
