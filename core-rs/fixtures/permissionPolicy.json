{
  "note": "Embedded（src/core/tools/PermissionPolicy.ts resolveToolPermission）与 Standalone（core-rs/src/permission.rs resolve_tool_permission）的权限加工对照表。TS 侧测试断言 resolveToolPermission 的真实输出等于本表；Rust 侧测试断言 resolve_tool_permission 的输出等于本表。路径用 __CWD__ 占位，两侧测试运行时替换为会话工作目录。displayArgs.diffHunks 在两侧比较前统一剔除：Standalone 不预计算该键，webview 会用同一份 beforeContent/afterContent 调 buildEditDiffHunks 得到一致渲染。",
  "cases": [
    {
      "name": "edit-single-line",
      "why": "整行替换：permResult 带 before/after/上下文/行号，displayArgs 展开绝对路径与 diff 字段",
      "tool": "Edit",
      "mode": "manual",
      "files": {
        "a.txt": "alpha\nbeta\ngamma\n"
      },
      "args": {
        "file_path": "a.txt",
        "old_string": "beta",
        "new_string": "BETA"
      },
      "expectPermResult": {
        "behavior": "ask",
        "message": "请求编辑文件：a.txt",
        "choices": [
          {
            "label": "允许",
            "description": "应用编辑"
          },
          {
            "label": "拒绝",
            "description": "取消操作"
          }
        ],
        "beforeContent": "alpha\nbeta\ngamma\n",
        "afterContent": "alpha\nBETA\ngamma\n",
        "contextBefore": [
          "alpha"
        ],
        "contextAfter": [
          "gamma"
        ],
        "lineEndings": "LF",
        "startLine": 2,
        "endLine": 2
      },
      "expectDisplayArgs": {
        "file_path": "__CWD__\\a.txt",
        "old_string": "beta",
        "new_string": "BETA",
        "replace_all": false,
        "contextBefore": [
          "alpha"
        ],
        "contextAfter": [
          "gamma"
        ],
        "diffHunks": [
          {
            "lines": [
              {
                "lineNumber": 1,
                "content": "alpha",
                "type": "unchanged"
              },
              {
                "lineNumber": 2,
                "content": "beta",
                "type": "removed",
                "wordDiff": [
                  {
                    "text": "beta",
                    "type": "removed"
                  }
                ]
              },
              {
                "lineNumber": 2,
                "content": "BETA",
                "type": "added",
                "wordDiff": [
                  {
                    "text": "BETA",
                    "type": "added"
                  }
                ]
              },
              {
                "lineNumber": 3,
                "content": "gamma",
                "type": "unchanged"
              },
              {
                "lineNumber": 4,
                "content": "",
                "type": "unchanged"
              }
            ]
          }
        ],
        "startLine": 2,
        "endLine": 2
      }
    },
