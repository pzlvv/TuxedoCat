{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "target": "ES2020",
    "outDir": "out",
    "rootDir": ".",
    "types": ["node", "mocha", "@vscode/test-electron"],
    "moduleResolution": "node",
    "esModuleInterop": true
  },
  "include": [
    "src/test/**/*.ts",
    "electron/sidebarFiles.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/webview/**/*"
  ]
}
