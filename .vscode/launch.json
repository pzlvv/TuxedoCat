{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Extension (VS Code)",
      "type": "extensionHost",
      "request": "launch",
      "preLaunchTask": "watch:ext",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "autoAttachChildProcesses": true
    },
    {
      "name": "Debug App (Electron)",
      "type": "node",
      "request": "attach",
      "preLaunchTask": "launch:app:debug",
      "port": 9229,
      "restart": true,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Run App (Electron)",
      "type": "node",
      "request": "launch",
      "noDebug": true,
      "preLaunchTask": "watch:app",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/scripts/electron-launch.js",
      "console": "integratedTerminal"
    }
  ],
  "compounds": []
}
