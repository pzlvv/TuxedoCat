{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build:webview",
      "type": "npm",
      "script": "build:webview",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "copy-assets",
      "type": "npm",
      "script": "copy-assets",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "build:electron",
      "type": "npm",
      "script": "build:electron",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "build:ext",
      "type": "npm",
      "script": "build",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "build:app",
      "dependsOn": ["build:webview", "copy-assets", "build:electron"],
      "dependsOrder": "sequence",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "watch:ext",
      "type": "npm",
      "script": "watch:ext",
      "isBackground": true,
      "group": "build",
      "problemMatcher": {
        "owner": "tuxedo-cat-watch-ext",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "watch:ext: start",
          "endsPattern": "watch:ext: ready"
        }
      }
    },
    {
      "label": "watch:app",
      "type": "npm",
      "script": "watch:app",
      "isBackground": true,
      "group": "build",
      "problemMatcher": {
        "owner": "tuxedo-cat-watch",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "watch:app: start",
          "endsPattern": "watch:app: ready"
        }
      }
    },
    {
      // 等价于 `npm run electron:debug`，额外透传隐藏的多实例测试参数：
      // VS Code 的 npm 任务类型只认 script/path、不支持追加参数，
      // 因此这里改用 shell + `npm run ... -- <args>`。
      // 固定 id（而非裸 --multi-instance）是为了让 userData 稳定，
      // 工作区 / 窗口位置能跨调试会话保留。
      "label": "launch:app:debug",
      "dependsOn": ["build:app"],
      "dependsOrder": "sequence",
      "type": "shell",
      "command": "npm",
      "args": ["run", "electron:debug", "--", "--multi-instance=debug"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "electron",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Debugger listening on ws://.*"
        }
      }
    }
  ]
}
