{
  "note": "Embedded（src/core/tools/PermissionPolicy.ts）与 Standalone（core-rs/src/permission.rs）的权限决策对照表。两侧测试读同一份文件，任一侧偏离都会失败。expect: allow | ask | deny。",
  "cases": [
    { "tool": "Bash", "mode": "risk", "args": { "command": "sleep 1" }, "expect": "allow", "why": "普通命令，risk 模式自动放行" },
    { "tool": "Bash", "mode": "manual", "args": { "command": "sleep 1" }, "expect": "ask", "why": "manual 模式一律询问" },
    { "tool": "Bash", "mode": "auto", "args": { "command": "sleep 1" }, "expect": "allow", "why": "auto 模式不弹框" },
    { "tool": "Bash", "mode": "risk", "args": { "command": "npm install" }, "expect": "allow", "why": "非只读但非危险，risk 放行" },
    { "tool": "Bash", "mode": "manual", "args": { "command": "ls -la" }, "expect": "allow", "why": "只读命令" },
    { "tool": "Bash", "mode": "manual", "args": { "command": "git status --short" }, "expect": "allow", "why": "只读多词命令" },
    { "tool": "Bash", "mode": "manual", "args": { "command": "echo hi && pwd" }, "expect": "allow", "why": "复合命令全部只读" },
    { "tool": "Bash", "mode": "manual", "args": { "command": "ls && rm -rf build" }, "expect": "ask", "why": "复合命令含非只读子命令" },
    { "tool": "Bash", "mode": "manual", "args": { "command": "echo a\nrm -rf build" }, "expect": "allow", "why": "换行不是分隔符：整段只看首词 echo（两侧必须一致）" },
    { "tool": "Bash", "mode": "manual", "args": { "command": "rm -rf build" }, "expect": "ask", "why": "写操作需要确认" },
    { "tool": "Bash", "mode": "risk", "args": { "command": "rm -rf build" }, "expect": "allow", "why": "rm 不属于破坏性命令，risk 放行" },
    { "tool": "Bash", "mode": "risk", "args": { "command": "dd if=/dev/zero of=x" }, "expect": "ask", "why": "破坏性命令，risk 拦截" },
    { "tool": "Bash", "mode": "auto", "args": { "command": "dd if=/dev/zero of=x" }, "expect": "allow", "why": "auto 模式放行一切" },
    { "tool": "Bash", "mode": "risk", "args": { "command": "git reset --hard HEAD" }, "expect": "ask", "why": "git reset 属于风险操作" },
    { "tool": "Bash", "mode": "risk", "args": { "command": "git checkout main" }, "expect": "ask", "why": "git checkout 属于风险操作" },
    { "tool": "Bash", "mode": "manual", "args": { "command": "git checkout main" }, "expect": "ask", "why": "manual 模式一律询问" },
    { "tool": "Bash", "mode": "auto", "args": { "command": "" }, "expect": "deny", "why": "命令为空：deny 不被 auto 转换" },
    { "tool": "Read", "mode": "manual", "args": { "file_path": "a.txt" }, "expect": "allow", "why": "只读工具" },
    { "tool": "Read", "mode": "auto", "args": { "file_path": "a.txt" }, "expect": "allow", "why": "只读工具" },
    { "tool": "Grep", "mode": "manual", "args": { "pattern": "x" }, "expect": "allow", "why": "只读工具" },
    { "tool": "Glob", "mode": "manual", "args": { "pattern": "*.ts" }, "expect": "allow", "why": "只读工具" },
    { "tool": "TodoWrite", "mode": "manual", "args": { "todos": [] }, "expect": "allow", "why": "只读工具" },
    { "tool": "Write", "mode": "manual", "args": { "file_path": "out.txt", "content": "x" }, "expect": "ask", "why": "写工具需要确认" },
    { "tool": "Write", "mode": "risk", "args": { "file_path": "out.txt", "content": "x" }, "expect": "allow", "why": "非危险写操作，risk 放行" },
    { "tool": "Write", "mode": "auto", "args": { "file_path": "out.txt", "content": "x" }, "expect": "allow", "why": "auto 模式放行" },
    { "tool": "Write", "mode": "auto", "args": {}, "expect": "deny", "why": "缺 file_path：checkPermissions 直接 deny，auto 不加工" },
    { "tool": "Write", "mode": "risk", "args": { "file_path": "" }, "expect": "deny", "why": "file_path 为空串同样非法" },
    { "tool": "Write", "mode": "auto", "args": { "file_path": "out.txt" }, "expect": "deny", "why": "缺 content：直接 deny" },
    { "tool": "Edit", "mode": "auto", "args": {}, "expect": "deny", "why": "缺 file_path：直接 deny" },
    { "tool": "Edit", "mode": "auto", "args": { "file_path": "missing-edit.txt" }, "expect": "deny", "why": "缺 old_string：直接 deny" },
    { "tool": "Edit", "mode": "auto", "args": { "file_path": "missing-edit.txt", "old_string": "a" }, "expect": "deny", "why": "缺 new_string：直接 deny" },
    { "tool": "Edit", "mode": "auto", "args": { "file_path": "missing-edit.txt", "old_string": "a", "new_string": "b" }, "expect": "deny", "why": "目标文件不存在：提示改用 Write" },
    { "tool": "Edit", "mode": "auto", "args": { "file_path": "edit-parity.txt", "old_string": "zzz", "new_string": "y" }, "expect": "deny", "why": "old_string 找不到：checkPermissions 直接 deny，auto 也不放行", "files": { "edit-parity.txt": "a\nb\n" } },
    { "tool": "Edit", "mode": "auto", "args": { "file_path": "edit-parity.txt", "old_string": "x", "new_string": "y" }, "expect": "deny", "why": "多处匹配且未 replace_all：checkPermissions 直接 deny", "files": { "edit-parity.txt": "x\nx\n" } },
    { "tool": "Edit", "mode": "auto", "args": { "file_path": "edit-parity.txt", "old_string": "x", "new_string": "y", "replace_all": true }, "expect": "allow", "why": "replace_all=true 时多处匹配合法：ask 被 auto 放行", "files": { "edit-parity.txt": "x\nx\n" } },
    { "tool": "Bash", "mode": "risk", "args": { "command": "bash -c 'git reset --hard HEAD'" }, "expect": "ask", "why": "引号包裹的 git reset 仍命中 \\bgit\\s+(checkout|reset)\\b" },
    { "tool": "Bash", "mode": "risk", "args": { "command": "cd repo&&git checkout main" }, "expect": "ask", "why": "git 紧跟在 && 之后（无空白）仍命中词边界正则" },
    { "tool": "Bash", "mode": "risk", "args": { "command": "(git reset --hard)" }, "expect": "ask", "why": "括号包裹的 git reset 仍命中词边界正则" },
    { "tool": "Bash", "mode": "risk", "args": { "command": "\"git reset --hard\"" }, "expect": "ask", "why": "整段被引号包裹的 git reset 仍命中词边界正则" },
    { "tool": "Bash", "mode": "risk", "args": { "command": "x=git reset" }, "expect": "ask", "why": "环境变量前缀后紧跟 git reset 仍命中词边界正则" },
    { "tool": "Bash", "mode": "risk", "args": { "command": "echo mygit checkout main" }, "expect": "allow", "why": "mygit 不是 \\bgit（负向）" },
    { "tool": "Bash", "mode": "risk", "args": { "command": "git-checkout main" }, "expect": "allow", "why": "git-checkout 后无空白，不命中 \\s+（负向）" },
    { "tool": "Bash", "mode": "risk", "args": { "command": "\"git\" reset --hard" }, "expect": "allow", "why": "引号紧贴 git 后无空白，不命中 \\s+（负向）" },
    { "tool": "Bash", "mode": "risk", "args": { "command": "git\u00a0reset" }, "expect": "ask", "why": "JS \\s 含 NBSP，命中词边界正则" },
    { "tool": "Bash", "mode": "risk", "args": { "command": "git\u2028reset" }, "expect": "ask", "why": "JS \\s 含行分隔符 U+2028，命中词边界正则" },
    { "tool": "Bash", "mode": "risk", "args": { "command": "git\ufeffreset" }, "expect": "ask", "why": "JS \\s 含 ZWNBSP U+FEFF，命中词边界正则" },
    { "tool": "Bash", "mode": "risk", "args": { "command": "git\u0085reset" }, "expect": "allow", "why": "U+0085（NEL）不在 JS \\s 集合里，不命中（负向）" },
    { "tool": "Bash", "mode": "manual", "args": { "command": "echo hi;\u0085" }, "expect": "ask", "why": "U+0085 不是 JS 空白：`\u0085` 段保留，首词不是只读命令" },
    { "tool": "Bash", "mode": "manual", "args": { "command": "echo hi;\ufeff" }, "expect": "allow", "why": "U+FEFF 是 JS 空白：空段被 trim 丢弃，只剩只读的 echo hi" },
    { "tool": "Bash", "mode": "manual", "args": { "command": "ls\u0085;pwd" }, "expect": "ask", "why": "U+0085 不参与 JS 分词：ls\u0085 不是只读命令" },
    { "tool": "Bash", "mode": "manual", "args": { "command": "ls\ufeff;pwd" }, "expect": "allow", "why": "U+FEFF 参与 JS 分词：ls\ufeff 视为 ls，只读" },
    { "tool": "Bash", "mode": "manual", "args": { "command": "git\u0085status" }, "expect": "ask", "why": "U+0085 不分词：git\u0085status 不匹配只读多词对 git status" },
    { "tool": "Bash", "mode": "manual", "args": { "command": "git\ufeffstatus" }, "expect": "allow", "why": "U+FEFF 参与 JS 分词：命中只读多词对 git status" },
    { "tool": "Bash", "mode": "manual", "args": { "command": "git status\u0085" }, "expect": "ask", "why": "U+0085 留在段尾：多词对变成 git status\u0085，不匹配" },
    { "tool": "Bash", "mode": "manual", "args": { "command": "git status\ufeff" }, "expect": "allow", "why": "U+FEFF 被 JS trim 去掉：命中只读多词对 git status" },
    { "tool": "Bash", "mode": "manual", "args": { "command": "\u0085" }, "expect": "ask", "why": "仅 U+0085：JS trim 不去，首词不是只读命令" },
    { "tool": "Bash", "mode": "manual", "args": { "command": "\ufeff" }, "expect": "ask", "why": "仅 U+FEFF：JS trim 去空后无段，isReadOnly=false → ask" },
    { "tool": "AskUserQuestion", "mode": "manual", "args": { "question": "hi" }, "expect": "allow", "why": "checkPermissions 直接放行：提问在 call() 里弹框，不再双重确认" },
    { "tool": "AskUserQuestion", "mode": "risk", "args": { "question": "hi", "choices": [{ "label": "A" }, { "label": "B" }] }, "expect": "allow", "why": "risk 模式同样直接放行（非 Bash 不参与风险拦截）" },
    { "tool": "AskUserQuestion", "mode": "auto", "args": { "question": "hi" }, "expect": "deny", "why": "auto 模式下 AskUserQuestion 不可用：auto 分支覆盖 checkPermissions 直接 deny，不弹提问框" }
  ]
}
