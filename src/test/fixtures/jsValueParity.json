      "data": "data:text/plain,HHHH"
    },
    {
      "input": "data:image/svg+xml;base64,IIII",
      "mediaType": "image/svg+xml",
      "data": "IIII"
    },
    {
      "input": "data:image/png;base64,  spaced  ",
      "mediaType": "image/png",
      "data": "  spaced  "
