  "stringify": [
    {
      "input": null,
      "expected": "null"
    },
    {
      "input": true,
      "expected": "true"
    },
    {
      "input": false,
      "expected": "false"
    },
    {
      "input": 0,
      "expected": "0"
    },
    {
      "input": 1,
      "expected": "1"
    },
    {
      "input": 1.5,
      "expected": "1.5"
    },
    {
      "input": 1.0,
      "expected": "1"
    },
    {
      "input": 100.0,
      "expected": "100"
    },
    {
      "input": 1e21,
      "expected": "1e+21"
    },
    {
      "input": 1e-7,
      "expected": "1e-7"
    },
    {
      "input": -3,
      "expected": "-3"
    },
    {
      "input": "text",
      "expected": "text"
    },
    {
      "input": "",
      "expected": ""
    },
    {
      "input": [
        1,
        2
      ],
      "expected": "1,2"
    },
    {
      "input": [],
      "expected": ""
    },
    {
      "input": [1, null, 2],
      "expected": "1,,2"
    },
    {
      "input": [null],
      "expected": ""
    },
    {
      "input": [1, [2, null]],
      "expected": "1,2,"
    },
    {
      "input": {
        "a": 1
      },
      "expected": "[object Object]"
    },
    {
      "input": 9007199254740991,
      "expected": "9007199254740991"
